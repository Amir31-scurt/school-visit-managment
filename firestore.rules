rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── REQUESTS ───────────────────────────────────────────
    match /requests/{requestId} {

      // N'importe qui peut soumettre une demande (formulaire public)
      // Mais uniquement avec les champs requis et status = pending
      allow create: if
        request.resource.data.keys().hasAll([
          'schoolName',
          'contactPerson',
          'phone',
          'numberOfStudents',
          'preferredDate',
          'status',
          'source',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'public_form' &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 5 &&
        request.resource.data.schoolName is string &&
        request.resource.data.schoolName.size() > 0 &&
        request.resource.data.numberOfStudents is int &&
        request.resource.data.numberOfStudents > 0;

      // Lecture, modification, suppression → admins authentifiés uniquement
      allow read, update, delete: if request.auth != null;
    }

    // ─── SETTINGS ────────────────────────────────────────────
    // Templates de messages + capacité → admins uniquement
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // ─── TOUT LE RESTE → refusé par défaut ──────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
